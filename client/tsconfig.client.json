{
   "exclude": ["@", "node_modules", "**/*test*.ts", "**/*.d.ts"],
   "include": ["./index.ts"],
   "compilerOptions": {
      "module": "none",
      "target": "esnext",
      "outFile": "./@/bundle.js",
      "lib": ["ESNext", "DOM"],
      "declaration": true,
      "skipLibCheck": true,  
      "declarationMap": false,
      "emitDeclarationOnly": false,
      "removeComments": true,
      "sourceMap": false
   }
}